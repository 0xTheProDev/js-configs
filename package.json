{
  "name": "js-configs",
  "private": true,
  "description": "A collection of Configurations useful for NodeJS and Web Projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xTheProDev/js-configs.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "create": "hygen package new",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "bun run .husky/install.mjs",
    "publish": "turbo run publish",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "check-yarn-lock": "0.2.1",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "sort-package-json": "4.1.0",
    "tsup": "9.0.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@1.22.0",
  "engines": {
    "node": ">= 20"
  }
}
