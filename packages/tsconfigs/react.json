{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": "./bundler",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "esnext", "scripthost", "webworker"],
    "noEmit": true,
    "target": "es2015"
  }
}
