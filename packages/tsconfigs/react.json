{
  "$schema": "http://json.schemastore.org/tsconfig",

  "extends": "./base",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "esnext", "scripthost", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "es2015"
  }
}
